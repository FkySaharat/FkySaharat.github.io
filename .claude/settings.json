{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npx astro check)",
      "Bash(astro dev --background)",
      "Bash(astro dev stop)",
      "Bash(astro dev status)",
      "Bash(astro dev logs)"
    ],
    "deny": [
      "Edit(dist/**)",
      "Edit(.astro/**)",
      "Edit(node_modules/**)"
    ]
  }
}
