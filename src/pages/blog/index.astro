---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import T from '../../components/T.astro';
import { getPublishedPosts } from '../../lib/content';
import { SITE, pageTitle } from '../../site.config';

const posts = await getPublishedPosts();
---

<Layout title={pageTitle(SITE.blog.title.en)} description={SITE.blog.description}>
	<h1><T t={SITE.blog.title} /></h1>
	<p class="intro"><T t={SITE.blog.intro} /></p>
	<PostList posts={posts} />
</Layout>

<style>
	h1 {
		font-size: 40px;
		letter-spacing: -0.02em;
		margin-bottom: 8px;
	}

	.intro {
		color: var(--muted);
		margin-bottom: 48px;
	}
</style>
