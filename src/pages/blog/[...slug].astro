---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import T from '../../components/T.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { UI } from '../../i18n';
import { getPublishedPosts } from '../../lib/content';
import { pageTitle } from '../../site.config';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, lang } = post.data;
// A table of contents only helps when there's something to jump between
const showToc = headings.filter((h) => h.depth === 2).length >= 3;
---

<Layout
	title={pageTitle(title)}
	description={description}
	lang={lang}
	article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
>
	<article lang={lang}>
		<header>
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span>
							· <T t={UI.blog.updated} /> <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
			{
				tags.length > 0 && (
					<ul class="tag-list tags">
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}
		</header>
		{
			showToc && (
				<details class="toc-mobile">
					<summary id="toc-summary">
						<T t={UI.blog.onThisPage} />
					</summary>
					<TableOfContents headings={headings} labelledBy="toc-summary" />
				</details>
			)
		}
		<div class="post-body">
			{
				showToc && (
					<aside class="toc-desktop">
						<TableOfContents headings={headings} titleId="toc-title" />
					</aside>
				)
			}
			<div class="prose">
				<Content />
			</div>
		</div>
	</article>
	<a href="/blog/" class="back"><T t={UI.blog.backToAll} /></a>
</Layout>

<style>
	header {
		margin-bottom: 40px;
	}

	h1 {
		font-size: 40px;
		line-height: 1.2;
		letter-spacing: -0.02em;
		margin-bottom: 12px;
	}

	.meta {
		color: var(--muted);
		font-size: 14px;
	}

	.tags {
		margin-top: 12px;
	}

	.back {
		display: inline-block;
		margin-top: 56px;
		color: var(--muted);
		text-decoration: none;
		font-size: 15px;
	}

	.back:hover {
		color: var(--text);
	}

	/* Table of contents: a collapsible box on narrow screens, a sticky sidebar on wide ones */
	.toc-mobile {
		margin-bottom: 32px;
		padding: 12px 16px;
		border: 1px solid var(--border);
		border-radius: 8px;
	}

	.toc-mobile summary {
		cursor: pointer;
		font-size: 14px;
		font-weight: 600;
		color: var(--muted);
	}

	.toc-mobile[open] summary {
		margin-bottom: 12px;
	}

	.post-body {
		position: relative;
	}

	.toc-desktop {
		display: none;
	}

	/*
	 * Sidebar sits in the empty space LEFT of the 720px content column.
	 * Needs (viewport - 720) / 2 + 24px padding >= 200px sidebar + 40px gap,
	 * i.e. a viewport of at least ~1200px.
	 */
	@media (min-width: 1200px) {
		.toc-mobile {
			display: none;
		}

		.toc-desktop {
			display: block;
			position: absolute;
			top: 0;
			bottom: 0;
			right: calc(100% + 40px);
			width: 200px;
		}

		.toc-desktop :global(.toc) {
			position: sticky;
			top: 24px;
			max-height: calc(100vh - 48px);
			overflow-y: auto;
		}
	}

	/* Leave a little space above a heading when jumping to it */
	.prose :global(h2),
	.prose :global(h3) {
		scroll-margin-top: 24px;
	}

	/* Styles for rendered Markdown (not scoped by Astro, so use :global) */
	.prose :global(h2) {
		font-size: 26px;
		margin: 40px 0 12px;
	}

	.prose :global(h3) {
		font-size: 20px;
		margin: 32px 0 8px;
	}

	.prose :global(p),
	.prose :global(ul),
	.prose :global(ol),
	.prose :global(pre),
	.prose :global(blockquote) {
		margin-bottom: 20px;
	}

	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 24px;
	}

	.prose :global(a) {
		color: var(--accent);
	}

	.prose :global(code) {
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: 0.9em;
	}

	.prose :global(:not(pre) > code) {
		background: var(--surface);
		padding: 2px 6px;
		border-radius: 4px;
	}

	.prose :global(pre) {
		padding: 16px;
		border-radius: 8px;
		overflow-x: auto;
		font-size: 14px;
	}

	.prose :global(blockquote) {
		border-left: 3px solid var(--border);
		padding-left: 16px;
		color: var(--muted);
	}

	.prose :global(table) {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
		margin-bottom: 24px;
		font-size: 15px;
		line-height: 1.5;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 10px 14px;
		text-align: left;
		vertical-align: top;
		border-bottom: 1px solid var(--border);
	}

	.prose :global(th) {
		background: var(--surface);
		font-weight: 600;
		white-space: nowrap;
	}

	.prose :global(tr:last-child td) {
		border-bottom: none;
	}

	/* Let long paths like `src/site.config.ts` wrap inside narrow cells */
	.prose :global(td code) {
		overflow-wrap: anywhere;
	}

	@media (max-width: 640px) {
		.prose :global(table) {
			font-size: 14px;
		}

		.prose :global(th),
		.prose :global(td) {
			padding: 8px 10px;
		}
	}

	.prose :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: 8px;
	}
</style>
