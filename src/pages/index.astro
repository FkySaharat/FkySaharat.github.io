---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts, getPublishedProjects } from '../lib/content';
import { EDUCATION, EXPERIENCE, LANGUAGES, SITE, SKILLS, SOCIAL_LINKS } from '../site.config';

const projects = await getPublishedProjects();
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<Layout>
	<section class="hero">
		<h1>
			{SITE.name}
			<span class="name-th" lang="th">{SITE.nameTh}</span>
		</h1>
		<p class="role">{SITE.role}</p>
		<p class="location">
			<Icon name="mapPin" size={16} />
			{SITE.location}
		</p>
		<p class="description">{SITE.bio}</p>
		<div class="links">
			{
				SOCIAL_LINKS.map((link) => {
					const external = link.href.startsWith('http');
					return (
						<a
							href={link.href}
							class={`btn btn-${link.variant}`}
							target={external ? '_blank' : undefined}
							rel={external ? 'noopener noreferrer' : undefined}
						>
							<Icon name={link.icon} />
							{link.label}
						</a>
					);
				})
			}
		</div>
	</section>

	<section>
		<h2>Experience</h2>
		<ol class="timeline">
			{
				EXPERIENCE.map((job) => (
					<li class="card job">
						<div class="job-head">
							<div>
								<h3>{job.role}</h3>
								<p class="company">
									{job.company} · {job.type}
								</p>
							</div>
							<p class="period">{job.period}</p>
						</div>
						<p class="job-summary">{job.summary}</p>
						<ul class="highlights">
							{job.highlights.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</li>
				))
			}
		</ol>
	</section>

	<section>
		<h2>Skills</h2>
		<div class="skills">
			{
				SKILLS.map((skill) => (
					<div class="card skill">
						<span class="skill-icon">
							<Icon name={skill.icon} />
						</span>
						<h3>{skill.title}</h3>
						<ul class="tag-list">
							{skill.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section class="split">
		<div>
			<h2>Education</h2>
			{
				EDUCATION.map((edu) => (
					<div class="card edu">
						<span class="skill-icon">
							<Icon name="graduationCap" />
						</span>
						<h3>{edu.school}</h3>
						<p>{edu.degree}</p>
						<p class="muted">{edu.program}</p>
						<p class="muted">
							{edu.period} · GPA {edu.gpa}
						</p>
					</div>
				))
			}
		</div>
		<div>
			<h2>Languages</h2>
			<ul class="card languages">
				{
					LANGUAGES.map((lang) => (
						<li>
							<span>{lang.name}</span>
							<span class="muted">{lang.level}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{
		projects.length > 0 && (
			<section>
				<h2>Projects</h2>
				<div class="projects">
					{projects.map(({ data }) => (
						<article class="card project">
							<h3>{data.title}</h3>
							<p>{data.description}</p>
							{data.tech.length > 0 && <p class="tech">{data.tech.join(' · ')}</p>}
							<div class="project-links">
								{data.repo && (
									<a href={data.repo} target="_blank" rel="noopener noreferrer">
										Code →
									</a>
								)}
								{data.demo && (
									<a href={data.demo} target="_blank" rel="noopener noreferrer">
										Live demo →
									</a>
								)}
							</div>
						</article>
					))}
				</div>
			</section>
		)
	}

	<section>
		<div class="section-head">
			<h2>Latest posts</h2>
			<a href="/blog/">All posts →</a>
		</div>
		<PostList posts={latestPosts} />
	</section>
</Layout>

<style>
	section {
		margin-bottom: 72px;
	}

	h1 {
		font-size: 48px;
		font-weight: 700;
		margin-bottom: 16px;
		letter-spacing: -0.02em;
	}

	h2 {
		font-size: 24px;
		letter-spacing: -0.01em;
		margin-bottom: 24px;
	}

	.name-th {
		display: inline-block;
		font-size: 20px;
		font-weight: 500;
		color: var(--muted);
		letter-spacing: 0;
	}

	.role {
		font-size: 18px;
		color: var(--muted);
		margin-bottom: 4px;
		font-weight: 500;
	}

	.location {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		color: var(--muted);
		margin-bottom: 24px;
	}

	.muted {
		color: var(--muted);
		font-size: 14px;
	}

	.timeline {
		list-style: none;
		display: grid;
		gap: 16px;
	}

	.job-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 16px;
		flex-wrap: wrap;
	}

	.job h3 {
		font-size: 18px;
	}

	.company {
		font-size: 15px;
		color: var(--accent);
		font-weight: 500;
	}

	.period {
		font-size: 13px;
		color: var(--muted);
		white-space: nowrap;
	}

	.job-summary {
		font-size: 15px;
		color: var(--text-secondary);
		margin-top: 8px;
	}

	.highlights {
		margin-top: 12px;
		padding-left: 20px;
		font-size: 15px;
		color: var(--text-secondary);
		display: grid;
		gap: 6px;
	}

	.split {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 24px;
	}

	.edu h3 {
		font-size: 18px;
		margin-bottom: 4px;
	}

	.edu p {
		font-size: 15px;
	}

	.languages {
		list-style: none;
		display: grid;
		gap: 12px;
	}

	.languages li {
		display: flex;
		justify-content: space-between;
		font-size: 15px;
	}

	.description {
		font-size: 16px;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 32px;
	}

	.links {
		display: flex;
		gap: 16px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 16px;
		text-decoration: none;
		border-radius: 6px;
		font-size: 14px;
		font-weight: 600;
		transition: background-color 0.2s;
	}

	.btn-neutral {
		background-color: var(--surface);
		color: var(--text);
	}

	.btn-neutral:hover {
		background-color: var(--surface-hover);
	}

	.btn-primary {
		background-color: var(--accent);
		color: var(--bg);
	}

	.btn-primary:hover {
		background-color: var(--accent-hover);
	}

	.skills {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 16px;
	}

	.skill-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: var(--surface);
		color: var(--accent);
		margin-bottom: 12px;
	}

	.skill h3 {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 10px;
	}

	.projects {
		display: grid;
		gap: 16px;
	}

	.project h3 {
		font-size: 18px;
		margin-bottom: 4px;
	}

	.project p {
		font-size: 15px;
		color: var(--text-secondary);
	}

	.project .tech {
		font-size: 13px;
		color: var(--muted);
		margin-top: 8px;
	}

	.project-links {
		display: flex;
		gap: 16px;
		margin-top: 12px;
	}

	.project-links a,
	.section-head a {
		font-size: 14px;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

	@media (max-width: 640px) {
		h1 {
			font-size: 36px;
		}

		.split {
			grid-template-columns: 1fr;
		}
	}
</style>
