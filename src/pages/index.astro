---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<section class="hero">
			<h1>Fluk Saharat</h1>
			<p class="role">Software Engineer</p>
			<p class="description">
				Building scalable applications with C# and SQL. Focused on clean code and efficient solutions.
			</p>
			<div class="links">
				<a href="https://github.com/FkySaharat" target="_blank" class="github-link">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
					</svg>
					GitHub
				</a>
				<a href="https://www.linkedin.com/in/saharat-diewtrakul-bb63a520b/" target="_blank" class="linkedin-link">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.475-2.236-1.986-2.236-1.081 0-1.722.722-2.004 1.418-.103.249-.129.597-.129.946v5.441h-3.554s.05-8.736 0-9.646h3.554v1.364c.429-.661 1.196-1.604 2.905-1.604 2.121 0 3.71 1.385 3.71 4.362v5.524zM5.337 8.855c-1.144 0-1.915-.761-1.915-1.712 0-.951.77-1.713 1.96-1.713 1.188 0 1.913.762 1.938 1.713 0 .951-.75 1.712-1.983 1.712zm1.946 11.597H3.392V9.009h3.891v11.443zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
					</svg>
					LinkedIn
				</a>
			</div>
		</section>

		<section class="skills">
			<div class="skill-item">
				<h3>Backend</h3>
				<p>C#, ASP.NET</p>
			</div>
			<div class="skill-item">
				<h3>Database</h3>
				<p>SQL, Database Design</p>
			</div>
		</section>
	</main>
</Layout>

<style>
	main {
		max-width: 640px;
		margin: 0 auto;
		padding: 80px 24px;
	}

	.hero {
		margin-bottom: 80px;
	}

	h1 {
		font-size: 48px;
		font-weight: 700;
		margin-bottom: 16px;
		letter-spacing: -0.02em;
	}

	.role {
		font-size: 18px;
		color: #666;
		margin-bottom: 24px;
		font-weight: 500;
	}

	.description {
		font-size: 16px;
		color: #555;
		line-height: 1.7;
		margin-bottom: 32px;
	}

	.links {
		display: flex;
		gap: 16px;
		margin-bottom: 32px;
	}

	.github-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 16px;
		background-color: #f0f0f0;
		color: #1a1a1a;
		text-decoration: none;
		border-radius: 6px;
		font-size: 14px;
		font-weight: 600;
		transition: background-color 0.2s;
	}

	.github-link:hover {
		background-color: #e0e0e0;
	}

	.linkedin-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 16px;
		background-color: #0a66c2;
		color: #ffffff;
		text-decoration: none;
		border-radius: 6px;
		font-size: 14px;
		font-weight: 600;
		transition: background-color 0.2s;
	}

	.linkedin-link:hover {
		background-color: #084fa0;
	}

	.github-link svg,
	.linkedin-link svg {
		width: 20px;
		height: 20px;
	}

	.skills {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
	}

	.skill-item h3 {
		font-size: 14px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #1a1a1a;
		margin-bottom: 8px;
	}

	.skill-item p {
		font-size: 14px;
		color: #666;
	}

	@media (max-width: 640px) {
		main {
			padding: 60px 20px;
		}

		h1 {
			font-size: 36px;
		}

		.skills {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}
</style>
