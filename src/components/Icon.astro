export type IconName = keyof typeof icons;

interface Props {
	name: IconName;
	size?: number;
}

const { name, size = 20 } = Astro.props;
const icon = icons[name];
const paint =
	icon.style === 'fill'
		? ({ fill: 'currentColor' } as const)
		: ({ fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const);
